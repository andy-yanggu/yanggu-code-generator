<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.yanggu.code.generator.mapper.TemplateGroupPropertyMapper">

    <!-- 所有字段 -->
    <sql id="allColumns">
        id
        ,
        template_group_id,
        prop_title,
        prop_key,
        prop_default_value,
        component_type,
        component_options,
        required,
        column_span,
        prop_order,
        remark,
        create_time,
        update_time,
        is_delete
    </sql>

    <!-- 过滤SQL -->
    <sql id="whereSQL">
        <!-- 这里写过滤语句，过滤项需要加query前缀 -->
        <if test="@com.yanggu.code.generator.common.mybatis.util.MybatisUtil@isNotEmpty(query, 'propTitle')">
            AND prop_title LIKE CONCAT('%', #{query.propTitle}, '%')
        </if>
        <if test="@com.yanggu.code.generator.common.mybatis.util.MybatisUtil@isNotEmpty(query, 'propKey')">
            AND prop_key LIKE CONCAT('%', #{query.propKey}, '%')
        </if>
    </sql>

    <!-- Entity类字段映射 -->
    <resultMap type="com.yanggu.code.generator.domain.entity.TemplateGroupPropertyEntity" id="templateGroupPropertyMap">
        <id property="id" column="id"/>
        <result property="templateGroupId" column="template_group_id"/>
        <result property="propTitle" column="prop_title"/>
        <result property="propKey" column="prop_key"/>
        <result property="propDefaultValue" column="prop_default_value"/>
        <result property="componentType" column="component_type"/>
        <result property="componentOptions" column="component_options"
                typeHandler="com.yanggu.code.generator.config.LabelValueDataTypeHandler"/>
        <result property="required" column="required"/>
        <result property="propOrder" column="prop_order"/>
        <result property="columnSpan" column="column_span"/>
        <result property="remark" column="remark"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
        <result property="isDelete" column="is_delete"/>
    </resultMap>

    <!-- Entity分页 -->
    <select id="entityPage" resultMap="templateGroupPropertyMap">
        SELECT
        <include refid="allColumns"/>
        FROM
        gen_template_group_property
        <where>
            is_delete = 0
            <include refid="whereSQL"/>
        </where>
        <include refid="com.yanggu.code.generator.common.mybatis.mapper.BaseMapperPlus.orderBySQL"/>
    </select>

    <!-- Entity列表 -->
    <select id="entityList" resultMap="templateGroupPropertyMap">
        SELECT
        <include refid="allColumns"/>
        FROM
        gen_template_group_property
        <where>
            is_delete = 0
            <include refid="whereSQL"/>
        </where>
        <include refid="com.yanggu.code.generator.common.mybatis.mapper.BaseMapperPlus.orderBySQL"/>
    </select>

    <!-- VO分页 -->
    <select id="voPage" resultType="com.yanggu.code.generator.domain.vo.TemplateGroupPropertyVO">
        SELECT
        <include refid="allColumns"/>
        FROM
        gen_template_group_property
        <where>
            is_delete = 0
            <include refid="whereSQL"/>
        </where>
        <include refid="com.yanggu.code.generator.common.mybatis.mapper.BaseMapperPlus.orderBySQL"/>
    </select>

    <!-- VO列表 -->
    <select id="voList" resultType="com.yanggu.code.generator.domain.vo.TemplateGroupPropertyVO">
        SELECT
        <include refid="allColumns"/>
        FROM
        gen_template_group_property
        <where>
            is_delete = 0
            <include refid="whereSQL"/>
        </where>
        <include refid="com.yanggu.code.generator.common.mybatis.mapper.BaseMapperPlus.orderBySQL"/>
    </select>

</mapper>